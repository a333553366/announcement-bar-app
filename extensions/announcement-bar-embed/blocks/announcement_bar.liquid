{% assign settings_data = app.metafields.announcement_bar.settings.value %}
{% assign is_enabled = settings_data.enabled %}
{% if is_enabled == nil %}{% assign is_enabled = true %}{% endif %}

{% if is_enabled %}
{% assign bg_color = settings_data.bgColor | default: '#111213' %}
{% assign text_color = settings_data.textColor | default: '#ffffff' %}
{% assign message = settings_data.message | default: 'Special Offer: Free Worldwide Shipping on All Orders!' %}
{% assign link_url = settings_data.linkUrl | default: '' %}
{% assign is_marquee = settings_data.isMarquee %}
{% if is_marquee == nil %}{% assign is_marquee = true %}{% endif %}

<div id="shopify-announcement-marquee-bar" style="background: {{ bg_color }}; color: {{ text_color }}; width: 100%; position: relative; z-index: 999999; overflow: hidden; padding: 10px 0; font-size: 14px; font-weight: 500; line-height: 1.4;">
  {% if is_marquee %}
    <div class="announcement-marquee-track">
      <div class="announcement-marquee-content">
        {% for i in (1..6) %}
          {% if link_url != blank %}
            <a href="{{ link_url }}" style="color: {{ text_color }}; text-decoration: none; padding: 0 35px; display: inline-block;">
              {{ message }}
            </a>
          {% else %}
            <span style="padding: 0 35px; display: inline-block;">{{ message }}</span>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  {% else %}
    <div style="text-align: center; padding: 0 20px;">
      {% if link_url != blank %}
        <a href="{{ link_url }}" style="color: {{ text_color }}; text-decoration: none;">
          {{ message }}
        </a>
      {% else %}
        <span>{{ message }}</span>
      {% endif %}
    </div>
  {% endif %}
</div>

<style>
.announcement-marquee-track {
  display: flex;
  width: 100%;
  overflow: hidden;
  user-select: none;
}
.announcement-marquee-content {
  display: flex;
  white-space: nowrap;
  animation: announcement-scroll 18s linear infinite;
  min-width: 100%;
}
.announcement-marquee-track:hover .announcement-marquee-content {
  animation-play-state: paused;
}
@keyframes announcement-scroll {
  from { transform: translateX(0%); }
  to { transform: translateX(-50%); }
}
</style>
{% endif %}

{% schema %}
{
  "name": "Announcement Bar",
  "target": "body"
}
{% endschema %}