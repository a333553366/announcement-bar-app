{% assign settings_data = app.metafields.announcement_bar.settings.value %}
{% assign is_enabled = settings_data.enabled %}
{% if is_enabled == nil %}{% assign is_enabled = true %}{% endif %}

{% if is_enabled %}
{% assign bg_color = settings_data.bgColor | default: '#111213' %}
{% assign text_color = settings_data.textColor | default: '#ffffff' %}
{% assign message = settings_data.message | default: 'Special Offer: Free Worldwide Shipping on All Orders!' %}
{% assign link_url = settings_data.linkUrl | default: '' %}
{% assign is_marquee = settings_data.isMarquee %}
{% if is_marquee == nil %}{% assign is_marquee = true %}{% endif %}

<div id="shopify-announcement-marquee-bar" style="background: {{ bg_color }}; color: {{ text_color }}; width: 100%; position: fixed; top: 0; left: 0; right: 0; z-index: 999999; overflow: hidden; padding: 10px 0; font-size: 14px; font-weight: 500; line-height: 1.4; box-shadow: 0 2px 6px rgba(0,0,0,0.12);">
  {% if is_marquee %}
    <div class="announcement-marquee-track">
      <div class="announcement-marquee-content">
        {% for i in (1..6) %}
          {% if link_url != blank %}
            <a href="{{ link_url }}" style="color: {{ text_color }}; text-decoration: none; padding: 0 35px; display: inline-block;">
              {{ message }}
            </a>
          {% else %}
            <span style="padding: 0 35px; display: inline-block;">{{ message }}</span>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  {% else %}
    <div style="text-align: center; padding: 0 20px;">
      {% if link_url != blank %}
        <a href="{{ link_url }}" style="color: {{ text_color }}; text-decoration: none;">
          {{ message }}
        </a>
      {% else %}
        <span>{{ message }}</span>
      {% endif %}
    </div>
  {% endif %}
</div>

<style>
.announcement-marquee-track {
  display: flex;
  width: 100%;
  overflow: hidden;
  user-select: none;
}
.announcement-marquee-content {
  display: flex;
  white-space: nowrap;
  animation: announcement-scroll 18s linear infinite;
  min-width: 100%;
}
.announcement-marquee-track:hover .announcement-marquee-content {
  animation-play-state: paused;
}
@keyframes announcement-scroll {
  from { transform: translateX(0%); }
  to { transform: translateX(-50%); }
}
</style>

<script>
(function() {
  function adjustBodyOffset() {
    var bar = document.getElementById('shopify-announcement-marquee-bar');
    if (bar) {
      var barHeight = bar.offsetHeight;
      document.body.style.paddingTop = barHeight + 'px';
      var stickyHeader = document.querySelector('sticky-header, .shopify-section-header-sticky, header.header');
      if (stickyHeader && getComputedStyle(stickyHeader).position === 'fixed') {
        stickyHeader.style.top = barHeight + 'px';
      }
    }
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', adjustBodyOffset);
  } else {
    adjustBodyOffset();
  }
  window.addEventListener('resize', adjustBodyOffset);
})();
</script>
{% endif %}

{% schema %}
{
  "name": "Announcement Bar",
  "target": "body"
}
{% endschema %}